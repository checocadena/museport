# Muse's SYCL ports of llm.c's dev/cuda kernel files (generated by `museport llmc-sycl`).
#   make                    build every port for the CPU device (JIT, spir64)
#   make TARGET=nvidia      ... for NVIDIA (intel/llvm with the CUDA backend)
#   make TARGET=amd AMD_ARCH=gfx950
# Ports that call oneMath need ONEMATH_PREFIX (a oneMath install with the matching backend).
SYCL_CXX ?= icpx
TARGET ?= cpu
AMD_ARCH ?= gfx90a
ifeq ($(TARGET),nvidia)
  TARGET_FLAGS = -fsycl-targets=nvptx64-nvidia-cuda
else ifeq ($(TARGET),amd)
  TARGET_FLAGS = -fsycl-targets=amdgcn-amd-amdhsa -Xsycl-target-backend=amdgcn-amd-amdhsa \
                 --offload-arch=$(AMD_ARCH)
else
  TARGET_FLAGS =
endif
ONEMATH_FLAGS = -I$(ONEMATH_PREFIX)/include -Wl,--no-as-needed -L$(ONEMATH_PREFIX)/lib \
                -Wl,-rpath,$(ONEMATH_PREFIX)/lib -lonemath

KERNELS = gelu_forward gelu_backward residual_forward permute crossentropy_forward crossentropy_softmax_backward encoder_forward encoder_backward adamw fused_residual_forward global_norm layernorm_forward classifier_fused layernorm_backward matmul_forward trimat_forward matmul_backward_bias softmax_forward matmul_backward
all: $(addprefix build/,$(KERNELS))
build:
	mkdir -p build
build/gelu_forward: gelu_forward/gelu_forward_sycl.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) gelu_forward/gelu_forward_sycl.cpp -o $@
build/gelu_backward: gelu_backward/gelu_backward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) gelu_backward/gelu_backward.cpp -o $@
build/residual_forward: residual_forward/residual_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) residual_forward/residual_forward.cpp -o $@
build/permute: permute/permute.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) permute/permute.cpp -o $@
build/crossentropy_forward: crossentropy_forward/crossentropy_forward_sycl.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) crossentropy_forward/crossentropy_forward_sycl.cpp -o $@
build/crossentropy_softmax_backward: crossentropy_softmax_backward/crossentropy_softmax_backward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) crossentropy_softmax_backward/crossentropy_softmax_backward.cpp -o $@
build/encoder_forward: encoder_forward/encoder_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) encoder_forward/encoder_forward.cpp -o $@
build/encoder_backward: encoder_backward/encoder_backward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) encoder_backward/encoder_backward.cpp -o $@
build/adamw: adamw/adamw_sycl.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) adamw/adamw_sycl.cpp -o $@
build/fused_residual_forward: fused_residual_forward/fused_residual_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) fused_residual_forward/fused_residual_forward.cpp -o $@
build/global_norm: global_norm/global_norm.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) global_norm/global_norm.cpp -o $@
build/layernorm_forward: layernorm_forward/layernorm.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) layernorm_forward/layernorm.cpp -o $@
build/classifier_fused: classifier_fused/classifier_fused.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) classifier_fused/classifier_fused.cpp -o $@
build/layernorm_backward: layernorm_backward/layernorm_backward_sycl.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) layernorm_backward/layernorm_backward_sycl.cpp -o $@
build/matmul_forward: matmul_forward/matmul_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) matmul_forward/matmul_forward.cpp -o $@ $(ONEMATH_FLAGS)
build/trimat_forward: trimat_forward/trimat_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) trimat_forward/trimat_forward.cpp -o $@ $(ONEMATH_FLAGS)
build/matmul_backward_bias: matmul_backward_bias/matmul_backward_bias.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) matmul_backward_bias/matmul_backward_bias.cpp -o $@
build/softmax_forward: softmax_forward/softmax_forward.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) softmax_forward/softmax_forward.cpp -o $@
build/matmul_backward: matmul_backward/matmul_backward_sycl.cpp | build
	$(SYCL_CXX) -fsycl -O2 $(TARGET_FLAGS) matmul_backward/matmul_backward_sycl.cpp -o $@ $(ONEMATH_FLAGS)
clean:
	rm -rf build
.PHONY: all clean
